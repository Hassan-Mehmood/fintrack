# Clerk authentication
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Public API URL used by the browser to reach the NestJS backend.
# This must match the API port exposed in docker-compose.yml.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Backend-only market-data credentials.
FINNHUB_API_KEY=your_finnhub_key
COINGECKO_API_KEY=your_coingecko_demo_key
EODHD_API_TOKEN=your_eodhd_token
EODHD_BASE_URL=https://eodhd.com/api

# Redis quote cache and conservative free-tier request budgets.
REDIS_URL=redis://localhost:6379
FINNHUB_REQUESTS_PER_MINUTE=50
COINGECKO_REQUESTS_PER_MINUTE=20
EODHD_REQUESTS_PER_DAY=20
