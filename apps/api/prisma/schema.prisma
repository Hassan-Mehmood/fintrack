generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  BANK
  CASH_WALLET
  DIGITAL_WALLET
  BROKER
  CRYPTO_WALLET
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  REFUND
  FEE
  INVESTMENT_BUY
  INVESTMENT_SELL
  DIVIDEND
  INTEREST
  INVESTMENT_SPLIT
  INVESTMENT_BONUS
  INVESTMENT_REINVESTMENT
  INVESTMENT_DEPOSIT
  INVESTMENT_WITHDRAWAL
  INVESTMENT_TRANSFER
  INVESTMENT_OPENING_POSITION
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  CLEARED
  FAILED
  VOIDED
}

enum AssetProvider {
  FINNHUB
  COINGECKO
  EODHD
}

enum AssetMarketType {
  STOCK
  CRYPTO
}

enum TradeType {
  OPENING
  BUY
  SELL
  DIVIDEND
  INTEREST
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  SPLIT
  BONUS
  FEE
  TAX
  REINVESTMENT
}

enum AssetLiquidityClass {
  INVESTMENT
  CASH_EQUIVALENT
}

enum AssetLiquidityClassSource {
  AUTO
  USER
}

model User {
  id                    String        @id @default(uuid()) @db.Uuid
  clerkId               String        @unique @map("clerk_id")
  email                 String        @unique
  name                  String?
  baseCurrency          String        @default("USD") @map("base_currency") @db.VarChar(3)
  exchangeRate          Decimal?      @map("exchange_rate") @db.Decimal(24, 8)
  exchangeRateSource    String        @default("MANUAL_SETTINGS") @map("exchange_rate_source")
  exchangeRateUpdatedAt DateTime?     @map("exchange_rate_updated_at")
  accounts              Account[]
  transactions          Transaction[]
  assets                Asset[]
  portfolios            Portfolio[]
  watchlists            Watchlist[]
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  id                       String                    @id @default(uuid()) @db.Uuid
  userId                   String                    @map("user_id") @db.Uuid
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                     String
  type                     AccountType
  currency                 String                    @db.VarChar(3)
  openingBalance           Decimal                   @default(0) @map("opening_balance") @db.Decimal(24, 8)
  displayOrder             Int                       @default(0) @map("display_order")
  openedAt                 DateTime                  @default(now()) @map("opened_at")
  archivedAt               DateTime?                 @map("archived_at")
  transactions             Transaction[]             @relation("TransactionAccount")
  transfersIn              Transaction[]             @relation("TransactionDestinationAccount")
  portfolios               PortfolioAccount[]
  portfolioHoldings        PortfolioHolding[]
  portfolioCashAllocations PortfolioCashAllocation[]
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, type])
  @@index([userId, displayOrder])
  @@map("accounts")
}

model Portfolio {
  id              String                    @id @default(uuid()) @db.Uuid
  userId          String                    @map("user_id") @db.Uuid
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  accounts        PortfolioAccount[]
  holdings        PortfolioHolding[]
  cashAllocations PortfolioCashAllocation[]
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("portfolios")
}

model PortfolioHolding {
  portfolioId String    @map("portfolio_id") @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  accountId   String    @map("account_id") @db.Uuid
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assetId     String    @map("asset_id") @db.Uuid
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([portfolioId, accountId, assetId])
  @@unique([accountId, assetId])
  @@index([portfolioId])
  @@index([assetId])
  @@map("portfolio_holdings")
}

model PortfolioCashAllocation {
  portfolioId String    @map("portfolio_id") @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  accountId   String    @map("account_id") @db.Uuid
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  percentage  Decimal   @db.Decimal(5, 2)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@id([portfolioId, accountId])
  @@index([accountId])
  @@map("portfolio_cash_allocations")
}

model PortfolioAccount {
  portfolioId String    @map("portfolio_id") @db.Uuid
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  accountId   String    @map("account_id") @db.Uuid
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([portfolioId, accountId])
  @@index([portfolioId])
  @@index([accountId])
  @@map("portfolio_accounts")
}

model Transaction {
  id                   String                       @id @default(uuid()) @db.Uuid
  userId               String                       @map("user_id") @db.Uuid
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId            String                       @map("account_id") @db.Uuid
  account              Account                      @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  destinationAccountId String?                      @map("destination_account_id") @db.Uuid
  destinationAccount   Account?                     @relation("TransactionDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  reversalOfId         String?                      @unique @map("reversal_of_id") @db.Uuid
  reversalOf           Transaction?                 @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal             Transaction?                 @relation("TransactionReversal")
  type                 TransactionType
  status               TransactionStatus            @default(CLEARED)
  idempotencyKey       String                       @default(uuid()) @map("idempotency_key") @db.Uuid
  amount               Decimal                      @db.Decimal(24, 8)
  currency             String                       @db.VarChar(3)
  occurredAt           DateTime                     @map("occurred_at")
  category             String
  description          String
  merchant             String?
  notes                String?
  reference            String?
  labels               String[]                     @default([])
  deletedAt            DateTime?                    @map("deleted_at")
  investmentDetail     InvestmentTransactionDetail?
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([userId, occurredAt])
  @@index([userId, status, occurredAt])
  @@index([userId, type])
  @@index([userId, category])
  @@index([accountId])
  @@index([accountId, occurredAt])
  @@index([destinationAccountId])
  @@map("transactions")
}

model AssetCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  assets    Asset[]

  @@map("asset_categories")
}

model RiskProfile {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  score     Int
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  assets    Asset[]

  @@map("risk_profiles")
}

model Asset {
  id                   String                        @id @default(uuid()) @db.Uuid
  userId               String                        @map("user_id") @db.Uuid
  user                 User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  symbol               String?
  provider             AssetProvider?
  marketType           AssetMarketType?              @map("market_type")
  providerAssetId      String?                       @map("provider_asset_id")
  exchange             String?
  imageUrl             String?                       @map("image_url")
  categoryId           String                        @map("category_id") @db.Uuid
  category             AssetCategory                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  riskProfileId        String?                       @map("risk_profile_id") @db.Uuid
  riskProfile          RiskProfile?                  @relation(fields: [riskProfileId], references: [id], onDelete: SetNull)
  currentPrice         Decimal?                      @map("current_price") @db.Decimal(24, 8)
  priceCurrency        String?                       @map("price_currency") @db.VarChar(3)
  notes                String?
  liquidityClass       AssetLiquidityClass           @default(INVESTMENT) @map("liquidity_class")
  liquidityClassSource AssetLiquidityClassSource     @default(AUTO) @map("liquidity_class_source")
  investmentDetails    InvestmentTransactionDetail[] @relation("InvestmentAsset")
  settlementDetails    InvestmentTransactionDetail[] @relation("SettlementAsset")
  portfolioHoldings    PortfolioHolding[]
  watchlistItems       WatchlistItem[]
  createdAt            DateTime                      @default(now()) @map("created_at")
  updatedAt            DateTime                      @updatedAt @map("updated_at")

  @@unique([userId, provider, providerAssetId])
  @@index([userId])
  @@index([userId, categoryId])
  @@index([categoryId])
  @@map("assets")
}

model Watchlist {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  displayOrder Int             @default(0) @map("display_order")
  items        WatchlistItem[]
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId, displayOrder])
  @@map("watchlists")
}

model WatchlistItem {
  watchlistId String    @map("watchlist_id") @db.Uuid
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  assetId     String    @map("asset_id") @db.Uuid
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([watchlistId, assetId])
  @@index([assetId])
  @@map("watchlist_items")
}

model InvestmentTransactionDetail {
  id                String      @id @default(uuid()) @db.Uuid
  transactionId     String      @unique @map("transaction_id") @db.Uuid
  transaction       Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  assetId           String      @map("asset_id") @db.Uuid
  asset             Asset       @relation("InvestmentAsset", fields: [assetId], references: [id], onDelete: Restrict)
  settlementAssetId String?     @map("settlement_asset_id") @db.Uuid
  settlementAsset   Asset?      @relation("SettlementAsset", fields: [settlementAssetId], references: [id], onDelete: Restrict)
  tradeType         TradeType   @map("trade_type")
  quantity          Decimal     @db.Decimal(24, 8)
  price             Decimal     @db.Decimal(24, 8)
  priceCurrency     String      @map("price_currency") @db.VarChar(3)
  grossAmount       Decimal     @map("gross_amount") @db.Decimal(24, 8)
  fees              Decimal     @default(0) @db.Decimal(24, 8)
  fxRateUsdToPkr    Decimal?    @map("fx_rate_usd_to_pkr") @db.Decimal(24, 8)
  fxRateSource      String?     @map("fx_rate_source")
  fxRateUpdatedAt   DateTime?   @map("fx_rate_updated_at")
  notes             String?
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@index([assetId])
  @@index([settlementAssetId])
  @@index([transactionId])
  @@map("investment_transaction_details")
}
